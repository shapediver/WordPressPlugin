{
  "name": "shapediver-wordpress-plugin",
  "version": "1.9",
  "description": "ShapeDiver WordPress Plugin",
  "author": "ShapeDiver GmbH",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "wp:start": "docker compose up -d --remove-orphans && docker compose --profile setup run --rm wpcli",
    "wp:stop": "docker compose stop",
    "wp:restart": "docker compose up -d --force-recreate --remove-orphans",
    "wp": "docker compose up",
    "wp:reset": "docker compose down -v --remove-orphans && docker compose up -d && docker compose --profile setup run --rm wpcli",
    "wp:status": "docker compose ps",
    "build": "tsc && vite build && ./build.sh",
    "deploy-test": "./deploy-test.sh wp/v1/main",
    "start": "vite",
    "optimize": "tsc && vite optimize --force && ./build.sh",
    "eslint": "eslint .",
    "prettier": "prettier --write ./src/modules ./src/*.ts ./src/*.css ./vite.config.ts ./eslint.config.mjs",
    "submodule": "git submodule update --init --recursive"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@shapediver/sdk.geometry-api-sdk-v2": "4.2.2",
    "@shapediver/viewer.shared.types": "3.21.5",
    "@types/node": "^20.17.19",
    "@types/post-robot": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.10.0",
    "prettier": "^3.5.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "5.9.3",
    "vite": "^6.2.0",
    "vite-bundle-analyzer": "^0.18.1",
    "vite-plugin-static-copy": "^1.0.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "post-robot": "8.0.32",
    "zod": "4.4.3"
  }
}
